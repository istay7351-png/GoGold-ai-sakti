<script>
let SYM='XAU';
const CFG={XAU:{ai:3918,liqB:3852.64,liqS:4000.48,base:3888},BTC:{ai:71200,liqB:70688,liqS:74092,base:70984}};
function makeChart(el){
  return LightweightCharts.createChart(document.getElementById(el),{layout:{background:{color:'#131722'},textColor:'#d1d4dc'},grid:{vertLines:{color:'#1e222d'},horzLines:{color:'#1e222d'}},timeScale:{timeVisible:true},height:el==='chart'?undefined:el==='vol'?70:90});
}
let chart=makeChart('chart'), volChart=makeChart('vol'), rsiChart=makeChart('rsi');
let candle=chart.addCandlestickSeries({upColor:'#26a69a',downColor:'#ef5350',wickUpColor:'#26a69a',wickDownColor:'#ef5350'});
let ma20=chart.addLineSeries({color:'#FFD700',lineWidth:1}), ma50=chart.addLineSeries({color:'#2962ff',lineWidth:1});
let volSeries=volChart.addHistogramSeries({priceFormat:{type:'volume'}});
let rsiSeries=rsiChart.addLineSeries({color:'#7e57c2',lineWidth:1.5});
let lines=[];
function draw(){
  const c=CFG[SYM];
  lines.forEach(l=>candle.removePriceLine(l)); lines=[];
  lines.push(candle.createPriceLine({price:c.ai,color:'#ffffff',lineWidth:2,lineStyle:2,title:'AI 3918'}));
  lines.push(candle.createPriceLine({price:c.liqB,color:'#00e676',lineWidth:2,lineStyle:2,title:'LIQ BUY'}));
  lines.push(candle.createPriceLine({price:c.liqS,color:'#ff5252',lineWidth:2,lineStyle:2,title:'LIQ SELL'}));
  let data=[], ma20D=[], ma50D=[], volD=[], rsiD=[];
  let price=c.base-30, now=Math.floor(Date.now()/1000);
  for(let i=80;i>=0;i--){
    let t=now-i*300, open=price, close=open+(Math.random()-0.5)*(SYM==='XAU'?8:400);
    let high=Math.max(open,close)+Math.random()*3, low=Math.min(open,close)-Math.random()*3;
    data.push({time:t,open,high,low,close}); volD.push({time:t,value:Math.random()*1000,color:close>=open?'#26a69a':'#ef5350'}); price=close;
  }
  for(let i=0;i<data.length;i++){
    if(i>=7){let s=0;for(let j=i-7;j<=i;j++)s+=data[j].close; ma20D.push({time:data[i].time,value:s/8});}
    if(i>=19){let s=0;for(let j=i-19;j<=i;j++)s+=data[j].close; ma50D.push({time:data[i].time,value:s/20});}
    rsiD.push({time:data[i].time,value:35+Math.random()*20});
  }
  candma20.setData(ma20D); ma50.setData(ma50D); volSeries.setData(volD); rsiSeries.setData(rsiD);
}
function setSym(s,el){SYM=s;document.querySelectorAll('.btn').forEach(b=>b.classList.remove('active'));el.classList.add('active');draw();}
draw(); setInterval(draw,60000);
</script>
